# Pixel Labs Network Builder - Environment Variables

# OpenAI Configuration (Optional - for AI-powered personalization)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Application Settings
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=pixel-labs-secret-key-change-me

# Database
DATABASE_URL=data/pixel_labs.db

# Daily Networking Target
DAILY_TARGET=20

# Category Distribution (percentages or counts)
CLIENTS_PER_DAY=5
REFERRAL_PARTNERS_PER_DAY=5
AGENCY_BUSINESS_PER_DAY=5
PROFESSIONAL_NETWORK_PER_DAY=5