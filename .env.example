# Pixel Labs Network Builder - Environment Variables

# ============================================
# AI Provider Configuration
# Supports: Groq (recommended), OpenAI, or any OpenAI-compatible provider
# ============================================

# Choose your AI provider: "groq" or "openai"
AI_PROVIDER=groq

# Groq Configuration (recommended for ICP filtering and enrichment)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.1-70b-versatile

# OpenAI Configuration (fallback)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Application Settings
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=pixel-labs-secret-key-change-me

# Database
DATABASE_URL=data/pixel_labs.db

# Daily Networking Target
DAILY_TARGET=20

# Category Distribution (per day)
CLIENTS_PER_DAY=5
REFERRAL_PARTNERS_PER_DAY=5
AGENCY_BUSINESS_PER_DAY=5
PROFESSIONAL_NETWORK_PER_DAY=5
